# Production canonical URL (no trailing slash). Defaults to https://krugersdorppainting.co.za if unset.
NEXT_PUBLIC_SITE_URL=https://krugersdorppainting.co.za

# Optional: paste the content value from Google Search Console → Settings → Ownership verification (meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_token_here

# Optional: Bing Webmaster Tools → meta tag value for msvalidate.01
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your_token_here

# Optional: full URL to a public Facebook Page (shown in JSON-LD sameAs)
# NEXT_PUBLIC_BUSINESS_FACEBOOK_URL=https://www.facebook.com/your-page

# Optional: X (Twitter) @handle without URL (used for twitter:site / twitter:creator)
# NEXT_PUBLIC_TWITTER_HANDLE=YourHandle
